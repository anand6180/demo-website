# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: HMAC secret for signing admin authentication cookies (auto-generated fallback in dev).
SESSION_SECRET="CHANGE_ME_TO_STRONG_RANDOM_SECRET"

# ADMIN_EMAIL / ADMIN_PASSWORD: Initial owner/admin credentials seeded on first boot.
ADMIN_EMAIL="admin@infinitygamingzone.in"
ADMIN_PASSWORD="ChangeMeInfinity2026!"

# RAZORPAY (Optional): Configure when enabling online advance payments.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
